[Unit]
Description=Read-only Douyin Playwright HTTP wrapper
After=network-online.target browser-relay.service
Wants=browser-relay.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/ai-social-browser/actions/douyin-tool
# 服务没有鉴权：只绑回环或内网地址，绝对不要绑公网网卡
ExecStart=/opt/ai-social-browser/actions/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8274
# Environment=DY_CDP_URL=http://127.0.0.1:9333
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
